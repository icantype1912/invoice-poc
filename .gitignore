# ===========================================
# 1. SECRETS & AUTH (NEVER COMMIT)
# ===========================================
.env
.env.*
!.env.template
secrets/
!secrets/.gitignore
!secrets/*.template

# Global Key Patterns
service-account-key.json
invoice-*-*.json
*.json.key
Drive.Personal.Auth/

# Backend Specific Configs
backend/appsettings.json
backend/appsettings.*.json
# Allowing specific local backups seen in your screenshots
backend/*.Backup.tmp

# ===========================================
# 2. BUILD OUTPUTS & DEPENDENCIES
# ===========================================
# C# / .NET
**/bin/
**/obj/
**/[Dd]ebug/
**/[Rr]elease/
packages/
*.nupkg

# Node / Angular
**/node_modules/
/dist/
/tmp/
/out-tsc/
/bazel-out/
/.angular/cache/
.sass-cache/

# Python
**/__pycache__/
**/*.py[cod]
*$py.class
*.so
.Python

# ===========================================
# 3. VIRTUAL ENVS & WORKER SPECIFIC
# ===========================================
**/venv/
**/env/
**/ENV/
**/.venv/
**/venv312/
worker/.ruff_cache/

# ===========================================
# 4. LOGS & DIAGNOSTICS
# ===========================================
**/logs/
*.log
npm-debug.log
yarn-error.log
testem.log
/libpeerconnection.log
/coverage/

# ===========================================
# 5. DATABASE & MIGRATIONS
# ===========================================
**/*.mdf
**/*.ldf
# As requested: Ignoring backend migrations
backend/Migrations/

# ===========================================
# 6. IDEs & EDITORS
# ===========================================
.vs/
.idea/
.project
.classpath
.c9/
.settings/
*.swp
*.swo
*.sublime-workspace
*.launch
.history/*

# Visual Studio / C# User Files
*.user
*.rsuser
*.sln.user
*.csproj.user

# VS Code (Allowing shared workspace settings)
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# ===========================================
# 7. OS & MISC
# ===========================================
.DS_Store
Thumbs.db
__screenshots__/
/typings/
/connect.lock
