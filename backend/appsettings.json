{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "",
    "SearchConnection": ""
  },
  "Jwt": {
    "Issuer": "",
    "Audience": "",
    "Secret": "",
    "AccessTokenMinutes": 60
  },
  "GoogleDrive": {
    "ServiceAccountKeyPath": "",
    "SharedFolderId": "",
    "ClientId": "",
    "ClientSecret": ""
  },
  "VirusTotal": {
    "ApiKey": ""
  },
  "AdminBootstrap": {
    "Email": "",
    "Password": ""
  },
  "JobCreation": {
    "IntervalSeconds": 30
  },
  "Groq": {
    "ApiKey": ""
  },
  "Security": {
    "CallbackSecret": "",
    "AdminApiKey": "YOUR_ADMIN_API_KEY",
    "MaxTokensAllowed": 120000,
    "MaxUploadsPerHour": 20
  },
  "Worker": {
    "CallbackUrl": "http://localhost:8000"
  },
  "Cors": {
    "AllowedOrigins": "http://localhost:4200,http://localhost:4201"
  },
  "AllowedHosts": "*"
}